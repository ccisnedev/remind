<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this to be requested at runtime; without it
         notifications are silently dropped. Declared here rather than relying
         on the merge from flutter_local_notifications, so that it is visible
         to anyone auditing what this app asks for.

         Note what is NOT here: no location permission of any kind, and no
         SCHEDULE_EXACT_ALARM. The scheduler defaults to inexact delivery,
         which needs no permission and is not restricted by Play policy. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- So reminders survive a reboot. Android clears every scheduled alarm
         when the device restarts; without this the plugin never learns that it
         happened and the user silently stops being reminded. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Exact delivery. Android 14 denies this by default; the user grants it
         from Settings → Apps → this app → Alarms & reminders, and the app can
         only send them there.

         SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM on purpose. The
         latter is granted silently at install with no prompt, but Google Play
         restricts it to apps whose *core* function is a clock, alarm or
         calendar, and reviews for it. A reminder feature embedded in an app
         that does something else does not qualify, so this demo shows the flow
         those apps will actually face. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <application
        android:label="remind_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- REQUIRED for scheduled notifications to appear at all.
             Since flutter_local_notifications v16 the plugin no longer declares
             its own receivers, so every app has to. Omit these and the failure
             is completely silent: the alarm is registered, it fires on time,
             the system logs the broadcast — and nothing runs, because it is
             addressed to a component that was never declared. No exception, no
             error in logcat, just a reminder that never arrives. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
